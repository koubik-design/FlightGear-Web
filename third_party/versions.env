# FlightGear's contributor documentation directs developers to its maintained
# OpenSceneGraph fork. The "next" branch is used for the current development
# line. The exact resolved commit is recorded in every dependency build manifest.
OSG_REPOSITORY=https://gitlab.com/flightgear/openscenegraph.git
OSG_REF=next
OSG_OPENGL_PROFILE=GLES3

# Emscripten ports used by the browser-target dependency build.
EMSCRIPTEN_PORTS="zlib libpng"
