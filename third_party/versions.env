# FlightGear's contributor guide recommends its maintained OSG fork.
# Pin the exact tested upstream commit; update deliberately when rebasing.
OSG_REPOSITORY=https://gitlab.com/flightgear/openscenegraph.git
OSG_REF=next
OSG_COMMIT=9090931c7753db996744d5d94dc00c9928a1d509
OSG_OPENGL_PROFILE=GLES3

# Emscripten ports used by the browser-target dependency build.
EMSCRIPTEN_PORTS="zlib libpng"
